{
  "permissions": {
    "allow": [
      "Bash(gh issue *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(uv run *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git -C * status)",
      "Bash(git -C * diff)"
    ]
  },
  "agent": "architect",
  "autoCompactWindow": 160000,
  "autoMemoryEnabled": false,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
